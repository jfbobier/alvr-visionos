<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string></string>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>SpatialGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_alvr._tcp</string>
	</array>
	<key>NSHandsTrackingUsageDescription</key>
	<string>AirFrameXR sends your hand positions and finger joints to the streamer so games can use your hands.</string>
	<key>NSWorldSensingUsageDescription</key>
	<string>AirFrameXR scans your surroundings to warn you before you walk into obstacles and to place the play area.</string>
	<key>NSAccessoryTrackingUsageDescription</key>
	<string>AirFrameXR sends the position of spatial controllers to the streamer.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>AirFrameXR connects to Steam Controllers, which are not visible to the system as standard game controllers.</string>
	<key>NSCameraUsageDescription</key>
	<string>AirFrameXR can send face tracking data to the streamer, using your Spatial Persona camera.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationPreferredDefaultSceneSessionRole</key>
		<string>UIWindowSceneSessionRoleApplication</string>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>LSSupportsGameMode</key>
	<true/>
</dict>
</plist>
